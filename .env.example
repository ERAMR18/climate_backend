# Copy this file to .env and replace every CHANGE_ME value.
SQLSERVER_SA_PASSWORD=CHANGE_ME_StrongSql_2026!
SQLSERVER_PORT=1433
# For external Kubernetes clients, set the host interface reachable from the cluster.
SQLSERVER_BIND_ADDRESS=127.0.0.1
JWT_SIGNING_KEY=CHANGE_ME_JwtSigningKey_2026_With32Chars!
INTERNAL_API_KEY=CHANGE_ME_InternalApiKey_2026_With32Chars!
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME_Admin_2026!
JWT_EXPIRATION_MINUTES=60
DEMO_SEED_ENABLED=true
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_SECONDS=30
FRONTEND_ORIGIN=http://localhost:4200
GATEWAY_PORT=8080
ConnectionStrings__IdentityDb=Server=localhost,1433;Database=IdentityDb;User Id=sa;Password=CHANGE_ME_StrongSql_2026!;TrustServerCertificate=True
ConnectionStrings__SensorDb=Server=localhost,1433;Database=SensorDb;User Id=sa;Password=CHANGE_ME_StrongSql_2026!;TrustServerCertificate=True
ConnectionStrings__MonitoringDb=Server=localhost,1433;Database=MonitoringDb;User Id=sa;Password=CHANGE_ME_StrongSql_2026!;TrustServerCertificate=True
ConnectionStrings__AlertDb=Server=localhost,1433;Database=AlertDb;User Id=sa;Password=CHANGE_ME_StrongSql_2026!;TrustServerCertificate=True
ConnectionStrings__EventDb=Server=localhost,1433;Database=EventDb;User Id=sa;Password=CHANGE_ME_StrongSql_2026!;TrustServerCertificate=True
ConnectionStrings__AuditDb=Server=localhost,1433;Database=AuditDb;User Id=sa;Password=CHANGE_ME_StrongSql_2026!;TrustServerCertificate=True
Jwt__Issuer=ClimateMonitoring.Identity
Jwt__Audience=ClimateMonitoring.Client
Jwt__SigningKey=CHANGE_ME_JwtSigningKey_2026_With32Chars!
Jwt__ExpirationMinutes=60
AdminSeed__Username=admin
AdminSeed__Email=admin@example.com
AdminSeed__Password=CHANGE_ME_Admin_2026!
DemoSeed__Enabled=true
InternalApi__ApiKey=CHANGE_ME_InternalApiKey_2026_With32Chars!
SensorService__BaseUrl=http://localhost:5102/
SensorService__ApiKey=USE_THE_SAME_VALUE_AS_InternalApi__ApiKey
AlertService__BaseUrl=http://localhost:5104/
AlertService__ApiKey=USE_THE_SAME_VALUE_AS_InternalApi__ApiKey
EventService__BaseUrl=http://localhost:5105/
EventService__ApiKey=USE_THE_SAME_VALUE_AS_InternalApi__ApiKey
RealtimeService__BaseUrl=http://localhost:5103/
RealtimeService__ApiKey=USE_THE_SAME_VALUE_AS_InternalApi__ApiKey
Cors__AllowedOrigins__0=http://localhost:4200
ReverseProxy__Clusters__identity__Destinations__primary__Address=http://localhost:5101/
ReverseProxy__Clusters__sensors__Destinations__primary__Address=http://localhost:5102/
ReverseProxy__Clusters__monitoring__Destinations__primary__Address=http://localhost:5103/
ReverseProxy__Clusters__alerts__Destinations__primary__Address=http://localhost:5104/
ReverseProxy__Clusters__events__Destinations__primary__Address=http://localhost:5105/
ReverseProxy__Clusters__audit__Destinations__primary__Address=http://localhost:5106/
Simulation__Enabled=true
Simulation__IntervalSeconds=30

# RabbitMQ credentials must be replaced locally. Compose uses its internal rabbitmq host.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=CHANGE_ME_AuditUser
RABBITMQ_PASSWORD=CHANGE_ME_StrongRabbitPassword
