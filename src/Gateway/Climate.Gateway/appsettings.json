{
  "Cors": { "AllowedOrigins": [ "http://localhost:4200" ] },
  "DownstreamHealthEndpoints": [
    "http://localhost:5101/health", "http://localhost:5102/health", "http://localhost:5103/health",
    "http://localhost:5104/health", "http://localhost:5105/health", "http://localhost:5106/health"
  ],
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "identity", "Match": { "Path": "/api/auth/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/auth" }, { "PathPrefix": "/api/v1/auth" } ] },
      "users": { "ClusterId": "identity", "Match": { "Path": "/api/users/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/users" }, { "PathPrefix": "/api/v1/users" } ] },
      "sensors": { "ClusterId": "sensors", "Match": { "Path": "/api/sensors/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/sensors" }, { "PathPrefix": "/api/v1/sensors" } ] },
      "communities": { "ClusterId": "sensors", "Match": { "Path": "/api/communities/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/communities" }, { "PathPrefix": "/api/v1/communities" } ] },
      "monitoring": { "ClusterId": "monitoring", "Match": { "Path": "/api/monitoring/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/monitoring" }, { "PathPrefix": "/api/v1/monitoring" } ] },
      "monitoring-hub": { "ClusterId": "monitoring", "Match": { "Path": "/hubs/monitoring/{**remainder}" } },
      "alerts": { "ClusterId": "alerts", "Match": { "Path": "/api/alerts/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/alerts" }, { "PathPrefix": "/api/v1/alerts" } ] },
      "events": { "ClusterId": "events", "Match": { "Path": "/api/events/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/events" }, { "PathPrefix": "/api/v1/events" } ] },
      "audit": { "ClusterId": "audit", "Match": { "Path": "/api/audit/{**remainder}" }, "Transforms": [ { "PathRemovePrefix": "/api/audit" }, { "PathPrefix": "/api/v1/audit" } ] }
    },
    "Clusters": {
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:5101/" } } },
      "sensors": { "Destinations": { "primary": { "Address": "http://localhost:5102/" } } },
      "monitoring": { "Destinations": { "primary": { "Address": "http://localhost:5103/" } } },
      "alerts": { "Destinations": { "primary": { "Address": "http://localhost:5104/" } } },
      "events": { "Destinations": { "primary": { "Address": "http://localhost:5105/" } } },
      "audit": { "Destinations": { "primary": { "Address": "http://localhost:5106/" } } }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp.ReverseProxy": "Information" } },
  "AllowedHosts": "*"
}
