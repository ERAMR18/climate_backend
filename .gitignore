publish/
Publish/
*.runtimeconfig.json
*.deps.json

# Ignore local secrets and environment files
.env
.env.*
!.env.example

# Docker overrides and local compose files
docker-compose.override.yml
docker-compose.*.local.yml

# Rider
.idea/

# Misc
*.log
node_modules/

# MSBuild BuildHost artifacts
**/BuildHost-*
